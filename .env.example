# ============================================================
# CRM Porto Di Vino — backend. Copie para `.env` e preencha.
# Foco deste CRM: o disparador de e-mail (módulo campanhas), via SendPulse.
# ============================================================

# Nome da casa: remetente padrão, rodapé dos e-mails e título da API.
CLIENTE_NOME=Porto Di Vino

# URL pública do CRM. Entra no pixel de abertura, na reescrita dos links e no
# link de descadastro de TODO e-mail — errada aqui, os links do e-mail não voltam.
APP_URL=https://crmportodivino.estudiodomaniai.com.br

# ============================================================
# Docker na VPS (docker-compose.yml, docs/DOCKER.md)
# ============================================================
# Domínio do CRM: registro A apontando para o IP da VPS ANTES de subir, para o
# Caddy tirar o certificado HTTPS.
CRM_DOMINIO=crmportodivino.estudiodomaniai.com.br
# Horário(s) do sync Domani -> banco, fuso de São Paulo. Ex.: 06:00,13:00
SYNC_HORARIOS=06:00
# Gerados pelo ./scripts/instalar.sh na primeira vez. NÃO troque depois que o
# banco existir: a senha fica gravada no volume do Postgres.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ============================================================
# Supabase Porto Di Vino
# ============================================================
# No Docker, estas quatro vêm do docker-compose.yml (banco e Auth locais) e
# o que estiver aqui é ignorado. Só se preenchem rodando fora do Docker.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=https://crmportodivino.estudiodomaniai.com.br

# ============================================================
# API Domani — canal da Porto Di Vino
# ============================================================

DOMANI_API_URL=https://app.estudiodomani.com/api
# Chave da conta da Porto Di Vino no Domani (sync diário de contatos).
DOMANI_API_KEY=

# ============================================================
# E-mail SMTP - convites e redefinicao de senha
# ============================================================
# Transacional da equipe (convite de acesso, "esqueci a senha"). Separado do
# SMTP de campanha. Vazio = cai no SMTP de campanha.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CRM Domani <ai@estudiooggi.com>
PASSWORD_RESET_TIMEOUT=


# ============================================================
# Disparador de e-mails — SendPulse (docs/DISPARADOR.md)
# ============================================================
# Comece SEMPRE em true: a campanha percorre o fluxo inteiro sem abrir SMTP.
# Só vire para false depois do roteiro de docs/DISPARADOR.md e com o DNS do
# portodivino.com.br autenticado (docs/DNS-PORTODIVINO.md).
# true = não envia (só registra). false = envia de verdade.
EMAIL_DRY_RUN=true

# SMTP do SendPulse — a conta da Domani, A MESMA de todos os CRMs (Mamma Jamma
# inclusive). O login é o e-mail da conta; a senha é a SENHA SMTP do painel
# (SMTP > Configurações), não a de entrar no site — é a mesma do .env da
# Mamma Jamma.
CAMPANHA_SMTP_HOST=smtp-pulse.com
CAMPANHA_SMTP_PORT=587
CAMPANHA_SMTP_USE_TLS=true
CAMPANHA_SMTP_USER=ai@estudiooggi.com
CAMPANHA_SMTP_PASSWORD=

# Remetente das campanhas: a caixa borabrindar@ da Porto (já existe; recebe as
# respostas dos clientes e o e-mail de verificação do SendPulse). O mesmo
# endereço está em backend/sql/seeds/cliente.sql.
# O domínio daqui (portodivino.com.br) é o que precisa de SPF/DKIM/DMARC —
# não o domínio do login SMTP.
CAMPANHA_FROM_EMAIL="Porto Di Vino <borabrindar@portodivino.com.br>"

# --- Limites de envio --------------------------------------------------------
# Vale sempre a janela mais apertada (hora, dia, mês).
#
# MÊS: a FATIA da Porto no plano SendPulse. A conta é uma só para todos os CRMs
# Domani, e cada CRM só enxerga o próprio envio: a soma do SMTP_LIMITE_MES de
# todos não pode passar do plano (a Mamma Jamma usa 10.000). Ver
# docs/DISPARADOR.md#conta-sendpulse-compartilhada.
SMTP_LIMITE_MES=5000
#
# DIA: controla o AQUECIMENTO do domínio. portodivino.com.br nunca disparou
# volume pelo SendPulse; comece baixo e suba a cada 2–3 dias sem bounce alto:
#   300 -> 600 -> 1200 -> 2500 (cerca de duas semanas)
SMTP_LIMITE_DIA=300
#
# HORA: metade do diário, para o volume do dia sair espalhado. O teto de
# 2500/h do SendPulse é da CONTA, dividido entre todos os CRMs: mesmo depois do
# aquecimento, deixe folga para os outros.
SMTP_LIMITE_HORA=150
#
# Nunca usar as últimas N vagas da janela (envio manual que o CRM não conta).
# SMTP_MARGEM=50
# Pausa entre mensagens, em segundos.
# SMTP_INTERVALO_SEG=1.5

# --- Webhooks de parceiros ---------------------------------------------------
# PDV Alpha Code (não usado pela Porto hoje). Vazia = o webhook recusa tudo.
WEBHOOK_ALPHACODE_KEY=

# ============================================================
# Módulos desligados neste CRM
# ============================================================
# Integrações (iFood, Google, Tripadvisor, Reclame Aqui), NPS e Parceiros estão
# desligados em frontend/src/config/cliente.ts. Sem as variáveis deles, os
# workers da API ficam parados — não há nada a preencher aqui.
# Para ligar algum depois, copie o bloco correspondente do .env.example do
# template (crm-domani-template) e siga o doc do módulo.
