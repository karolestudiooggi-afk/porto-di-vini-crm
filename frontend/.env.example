# ---------------------------------------------------------------------------
# CRM Porto Di Vino — front-end. Copie para `.env` e preencha.
#
# NEXT_PUBLIC_* é inlinada NO BUILD: mudou o valor, rode `npm run build` de novo.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLIENT_NAME=Porto Di Vino

# API FastAPI — mesma origem, atrás do nginx em /api/.
NEXT_PUBLIC_API_URL=https://crmportodivino.estudiodomaniai.com.br/api

# Supabase (Auth). Self-hosted: gateway Kong em /supabase/ no mesmo domínio.
# Na nuvem: a URL do projeto (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://crmportodivino.estudiodomaniai.com.br/supabase

# Chave pública `anon` do Supabase (JWT com role=anon). Pode ir para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
